<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.EvotingAPP" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorOutlineVariant">@color/outline_soft</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/surface_bg</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_primary</item>
        <item name="colorSecondaryContainer">@color/brand_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorOutline">@color/outline_soft</item>
        <item name="colorError">@color/status_danger</item>
        <item name="android:colorBackground">@color/surface_bg</item>
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.EvotingAPP" parent="Base.Theme.EvotingAPP" />

    <!-- ===== Tipografi ===== -->
    <style name="TextDisplay">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextHeaderTitle">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="TextOnInk">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:textColor">@color/on_ink_muted</item>
    </style>

    <style name="SectionTitle">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="BodyText">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="MutedText">
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Badge">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_badge</item>
    </style>

    <!-- ===== Permukaan ===== -->
    <style name="SectionCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <!-- Kartu surat suara: sudut kecil seperti kertas -->
    <style name="BallotCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">6dp</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <!-- Baris menu -->
    <style name="MenuRow" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Nomor langkah (urutan proses KPU) -->
    <style name="StepNumber">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_step_number</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>

    <style name="Button.Big" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
